    <!-- Microphone Permission Card & Rationale -->
    <string name="permission_rationale_title">Microphone Access Required</string>
    <string name="permission_rationale_body">To receive acoustic transmissions and calibrate frequency response, ShoutSend requires microphone access to detect audio carrier frequencies.</string>
    <string name="permission_denied_title">Microphone Permission Blocked</string>
    <string name="permission_denied_body">Microphone permission has been permanently denied. Please enable microphone access in Android application settings to receive sonic data.</string>
    <string name="permission_btn_open_settings">Open App Settings</string>
    <string name="permission_btn_grant">Grant Microphone Access</string>

